# Copy this file to .env and fill in real values. .env is gitignored.

# Twelve Data free-tier API key (https://twelvedata.com) - required for live/historical OHLC.
TWELVE_DATA_API_KEY=

# Twelve Data free tier allows 800 requests/day - used by the local rate-limit guard.
TWELVE_DATA_DAILY_REQUEST_LIMIT=800

# SQLite database file path.
DB_PATH=./var/forexmind.db

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

ENV=development

# Finnhub free-tier API key (https://finnhub.io) - economic calendar + forex news (Phase 9).
FINNHUB_API_KEY=

# Groq free-tier API key (https://console.groq.com) - primary LLM backend for the Reasoning Agent (Phase 12).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama fallback used by the Reasoning Agent when Groq is unreachable/rate-limited.
# Requires `ollama serve` running locally with the model pulled (`ollama pull llama3.3`).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3

# Optional: Slack/Discord-compatible incoming webhook URL. When set, pipeline
# failures (Phase 17 monitoring) are POSTed here in addition to being logged
# and stored in the pipeline_alerts table. Leave blank to disable.
ALERT_WEBHOOK_URL=

# Comma-separated browser origins allowed to call the API (CORS) - the
# frontend's Vite dev server by default. Extend/replace for a deployed
# frontend origin (see frontend/Development.md Phase 8).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
