# Copy this file to .env and fill in real values. .env is gitignored.

# Twelve Data free-tier API key (https://twelvedata.com) - required for live/historical OHLC.
TWELVE_DATA_API_KEY=

# Twelve Data free tier allows 800 requests/day - used by the local rate-limit guard.
TWELVE_DATA_DAILY_REQUEST_LIMIT=800

# SQLite database file path.
DB_PATH=./var/forexmind.db

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

ENV=development
